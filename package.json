{
  "name": "events-spa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc -b",
    "lint": "run-s lint:oxlint lint:eslint lint:style lint:fsd",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix lint:style:fix",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix --cache",
    "lint:style": "stylelint \"**/*.{css,scss,vue}\"",
    "lint:style:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
    "lint:fsd": "steiger ./src",
    "format": "prettier --write --experimental-cli .",
    "format:check": "prettier --check --experimental-cli ."
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "oxlint --fix",
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,vue}": [
      "stylelint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.104.0",
    "@tanstack/vue-virtual": "^3.13.39",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass-embedded": "^1.105.1",
    "steiger": "^0.7.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.3",
    "vitest-browser-vue": "^3.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^24.12.0",
    "pnpm": ">=10.0.0"
  }
}
